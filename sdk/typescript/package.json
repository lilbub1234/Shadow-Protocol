{
  "name": "@shade/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Shade Framework - Next-generation zero-knowledge privacy platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs": "typedoc --out docs src",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "zero-knowledge",
    "zk-snarks",
    "privacy",
    "cryptography",
    "blockchain",
    "shade",
    "shade-framework"
  ],
  "author": "Shadow Protocol Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shadow-protocol/shade.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/shadow-protocol/shade/issues"
  },
  "homepage": "https://shadeframework.io",
  "dependencies": {
    "snarkjs": "^0.7.3",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.9.0",
    "@solana/web3.js": "^1.87.6",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
